  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Edge",
      "items": [
        "Cloudflare Zero Trust Tunnel: no public ports exposed",
        "Caddy internal reverse proxy: /api/** to Gateway, static to Nginx",
        "Angular 21 PWA installable, no offline caching"
      ]
    },
    {
      "dot": "emerald",
      "title": "Microservices Core",
      "items": [
        "Spring Cloud Gateway: stateless JWT + Redis rate-limiting (20/min)",
        "Java 21 + Spring Boot 3.3.x with virtual threads enabled",
        "Fire-and-forget POST /internal/events on session completion",
        "PostgreSQL 16: auth, training, analytics schemas (Flyway-managed)"
      ]
    },
    {
      "dot": "rose",
      "title": "AWS & External Services",
      "items": [
        "AWS Lightsail VM hosts the full Docker Compose stack",
        "Automated cron pushes daily pg_dump to external AWS S3 bucket",
        "AWS SES / SMTP provider for email verification links",
        "GHCR stores 5 multi-stage Docker images per service"
      ]
    },
    {
      "dot": "violet",
      "title": "Observability & CI/CD",
      "items": [
        "Prometheus scrapes /actuator/prometheus from 4 services (30s)",
        "Promtail tails all Docker container stdout/stderr via docker.sock",
        "Grafana Loki stores logs; Grafana UI shows health + p95 latency",
        "GitHub Actions: CI tests+lint PRs, CD pushes to GHCR + SSH deploy"
      ]
    }
  ]
