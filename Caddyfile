:80 {
    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }

    # Route API requests to the API Gateway with retry buffering during restarts
    handle /api/* {
        reverse_proxy api-gateway:8080 {
            lb_try_duration 30s
            lb_try_interval 250ms
        }
    }

    # Route everything else to the Angular Frontend with retry buffering
    handle {
        reverse_proxy frontend:80 {
            lb_try_duration 15s
            lb_try_interval 250ms
        }
    }
}
